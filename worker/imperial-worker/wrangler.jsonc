{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imperial-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}